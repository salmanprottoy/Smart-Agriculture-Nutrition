# Railway Environment Variables Template
# Copy this file to .env.railway and fill in your actual values
# NEVER commit .env.railway to version control!

# PostgreSQL Database URL from Railway
# Get this from: railway variables (when Postgres service is selected)
DATABASE_PUBLIC_URL=postgresql://user:password@host:port/database

# JWT Secret for authentication
# Generate a secure random string for production
JWT_SECRET=your-secure-jwt-secret-here

# Optional: Other Railway-specific variables
# RAILWAY_ENVIRONMENT=production
# PORT=8080
