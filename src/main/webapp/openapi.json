{
  "openapi": "3.0.1",
  "info": {
    "title": "Smart Agriculture Nutrition",
    "description": "REST API connecting smart agriculture data with personal nutrition tracking. This API bridges the gap between agricultural production and personal health outcomes, creating a complete food-to-health ecosystem.",
    "contact": {
      "name": "Smart Agriculture Team",
      "url": "https://github.com/agriculture-nutrition/api",
      "email": "agriculture@nutrition.com"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080/SmartAgricultureNutrition/api/v1",
      "description": "Development Server"
    }
  ],
  "tags": [
    {
      "name": "Crop Nutrition Profiles",
      "description": "Operations related to crop nutrition profiles and agricultural data"
    },
    {
      "name": "Personal Nutrition Trackers",
      "description": "Personal nutrition tracking and health goal management"
    },
    {
      "name": "Weather",
      "description": "Real-time weather data for agricultural analysis"
    },
    {
      "name": "Nutrition",
      "description": "USDA nutrition database integration"
    },
    {
      "name": "Correlations",
      "description": "Weather-nutrition analysis and correlations"
    }
  ],
  "paths": {
    "/crop-nutrition-profiles": {
      "get": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Get all crop nutrition profiles",
        "description": "Retrieve a list of crop nutrition profiles with optional filtering by crop type, growing method, region, or season. Returns comprehensive agricultural data including sustainability scores and nutritional content.",
        "parameters": [
          {
            "name": "crop_type",
            "in": "query",
            "description": "Filter by crop type (e.g., tomato, carrot, wheat)",
            "schema": { "type": "string" },
            "example": "tomato"
          },
          {
            "name": "growing_method",
            "in": "query",
            "description": "Filter by growing method (e.g., organic, hydroponic, traditional)",
            "schema": { "type": "string" },
            "example": "organic"
          }
        ],
        "responses": {
          "200": {
            "description": "List of crop nutrition profiles retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CropNutritionProfile"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Create new crop nutrition profile",
        "description": "Create a new crop nutrition profile with automatic sustainability scoring and nutritional prediction",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CropNutritionProfile" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Crop profile created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropNutritionProfile"
                }
              }
            }
          }
        }
      }
    },
    "/crop-nutrition-profiles/{profileId}": {
      "get": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Get specific crop nutrition profile",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Crop profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropNutritionProfile"
                }
              }
            }
          },
          "404": { "description": "Crop profile not found" }
        }
      },
      "put": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Update crop nutrition profile",
        "description": "Update an existing crop nutrition profile with recalculated sustainability scoring",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CropNutritionProfile" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Crop profile updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CropNutritionProfile"
                }
              }
            }
          },
          "404": { "description": "Crop profile not found" }
        }
      },
      "delete": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Delete crop nutrition profile",
        "description": "Remove a crop nutrition profile and all associated harvest batches",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": { "description": "Crop profile deleted successfully" },
          "404": { "description": "Crop profile not found" }
        }
      }
    },
    "/crop-nutrition-profiles/{profileId}/harvest-batches": {
      "get": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Get harvest batches for crop profile",
        "description": "Retrieve harvest batches with quality grading and actual nutrient analysis",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "harvest_date",
            "in": "query",
            "description": "Filter by harvest date (YYYY-MM-DD)",
            "schema": { "type": "string" },
            "example": "2024-03-15"
          },
          {
            "name": "quality_grade",
            "in": "query",
            "description": "Filter by quality grade (A, B, C)",
            "schema": { "type": "string" },
            "example": "A"
          }
        ],
        "responses": {
          "200": {
            "description": "Harvest batches retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HarvestBatch" }
                }
              }
            }
          },
          "404": { "description": "Crop profile not found" }
        }
      },
      "post": {
        "tags": ["Crop Nutrition Profiles"],
        "summary": "Add harvest batch to crop profile",
        "description": "Add a new harvest batch with automatic nutrient analysis based on growing conditions",
        "parameters": [
          {
            "name": "profileId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/HarvestBatch" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Harvest batch created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HarvestBatch" }
              }
            }
          },
          "404": { "description": "Crop profile not found" }
        }
      }
    },
    "/nutrition-trackers": {
      "get": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Get all nutrition trackers",
        "description": "Retrieve personal nutrition trackers with BMI integration and health goal tracking",
        "parameters": [
          {
            "name": "bmi_range",
            "in": "query",
            "description": "Filter by BMI range (e.g., '20-25', 'under-18.5', 'over-30')",
            "schema": { "type": "string" },
            "example": "20-25"
          },
          {
            "name": "health_goal",
            "in": "query",
            "description": "Filter by health goal",
            "schema": { "type": "string" },
            "example": "Weight Maintenance"
          }
        ],
        "responses": {
          "200": {
            "description": "List of nutrition trackers retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PersonalNutritionTracker"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Create new nutrition tracker",
        "description": "Create a new nutrition tracker with BMI integration and automatic farm-to-fork scoring",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalNutritionTracker"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Nutrition tracker created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalNutritionTracker"
                }
              }
            }
          }
        }
      }
    },
    "/nutrition-trackers/{trackerId}": {
      "get": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Get specific nutrition tracker",
        "description": "Retrieve a specific nutrition tracker with HATEOAS navigation links",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Nutrition tracker retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalNutritionTracker"
                }
              }
            }
          },
          "404": { "description": "Nutrition tracker not found" }
        }
      },
      "put": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Update nutrition tracker",
        "description": "Update an existing nutrition tracker with recalculated farm-to-fork scoring",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PersonalNutritionTracker"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nutrition tracker updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PersonalNutritionTracker"
                }
              }
            }
          },
          "404": { "description": "Nutrition tracker not found" }
        }
      },
      "delete": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Delete nutrition tracker",
        "description": "Remove a nutrition tracker and all associated data",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "204": { "description": "Nutrition tracker deleted successfully" },
          "404": { "description": "Nutrition tracker not found" }
        }
      }
    },
    "/nutrition-trackers/{trackerId}/meal-sources": {
      "get": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Get meal sources for tracker",
        "description": "Retrieve meal sources with farm-to-fork tracking and local sourcing percentages",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          },
          {
            "name": "local_percentage",
            "in": "query",
            "description": "Filter by minimum local percentage",
            "schema": { "type": "number", "format": "double" },
            "example": 0.8
          },
          {
            "name": "date",
            "in": "query",
            "description": "Filter by date (YYYY-MM-DD)",
            "schema": { "type": "string" },
            "example": "2024-03-15"
          }
        ],
        "responses": {
          "200": {
            "description": "Meal sources retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MealSource" }
                }
              }
            }
          },
          "404": { "description": "Nutrition tracker not found" }
        }
      },
      "post": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Add meal source to tracker",
        "description": "Add a new meal source with automatic local sourcing percentage and nutritional density calculation",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MealSource" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Meal source added successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MealSource" }
              }
            }
          },
          "404": { "description": "Nutrition tracker not found" }
        }
      }
    },
    "/nutrition-trackers/{trackerId}/health-correlations": {
      "get": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Get health correlations for tracker",
        "description": "Analyze health correlations and patterns for the nutrition tracker",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Health correlations analysis completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "analysis": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "description": "Nutrition tracker not found" }
        }
      }
    },
    "/nutrition-trackers/{trackerId}/bmi-analysis": {
      "get": {
        "tags": ["Personal Nutrition Trackers"],
        "summary": "Get BMI analysis for tracker",
        "description": "BMI analysis with personalized recommendations based on current health status",
        "parameters": [
          {
            "name": "trackerId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "BMI analysis completed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userName": { "type": "string" },
                    "bmi": { "type": "number", "format": "double" },
                    "category": { "type": "string" },
                    "recommendations": { "type": "string" },
                    "farmToForkScore": { "type": "number", "format": "double" }
                  }
                }
              }
            }
          },
          "404": { "description": "Nutrition tracker not found" }
        }
      }
    },
    "/weather/current/{city}": {
      "get": {
        "tags": ["Weather"],
        "summary": "Get current weather for a city",
        "description": "Get real-time weather data from WeatherAPI.com for agricultural analysis",
        "parameters": [
          {
            "name": "city",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "Jyväskylä"
          }
        ],
        "responses": {
          "200": {
            "description": "Current weather data retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WeatherData" }
              }
            }
          }
        }
      }
    },
    "/nutrition/crop/{cropName}": {
      "get": {
        "tags": ["Nutrition"],
        "summary": "Get nutrition data for a crop",
        "description": "Get comprehensive nutrition data from USDA FoodData Central",
        "parameters": [
          {
            "name": "cropName",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "tomato"
          }
        ],
        "responses": {
          "200": {
            "description": "Nutrition data retrieved successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/FoodNutritionData" }
              }
            }
          }
        }
      }
    },
    "/correlations/crop-weather-nutrition/{city}/{crop}": {
      "get": {
        "tags": ["Correlations"],
        "summary": "Get comprehensive crop-weather-nutrition analysis",
        "description": "Analyze the correlation between weather conditions and crop nutritional outcomes",
        "parameters": [
          {
            "name": "city",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "Jyväskylä"
          },
          {
            "name": "crop",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "example": "tomato"
          }
        ],
        "responses": {
          "200": {
            "description": "Comprehensive analysis completed successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CorrelationAnalysis" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CropNutritionProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "cropName": {
            "type": "string",
            "example": "Organic Cherry Tomatoes"
          },
          "farmLocation": { "type": "string", "example": "Jyväskylä, Finland" },
          "growingMethod": { "type": "string", "example": "Organic" },
          "sustainabilityScore": {
            "type": "number",
            "format": "double",
            "example": 8.7
          },
          "soilNutrients": { "type": "object" },
          "cropNutrients": { "type": "object" },
          "certifications": { "type": "array", "items": { "type": "string" } },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "PersonalNutritionTracker": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "userName": { "type": "string", "example": "John Farmer" },
          "age": { "type": "integer", "example": 34 },
          "currentBmi": {
            "type": "number",
            "format": "double",
            "example": 24.5
          },
          "healthGoals": { "type": "array", "items": { "type": "string" } },
          "farmToForkScore": {
            "type": "number",
            "format": "double",
            "example": 8.2
          }
        }
      },
      "WeatherData": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Jyväskylä" },
          "main": {
            "type": "object",
            "properties": {
              "temp": { "type": "number", "format": "double" },
              "humidity": { "type": "number", "format": "double" },
              "pressure": { "type": "number", "format": "double" }
            }
          },
          "weather": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "main": { "type": "string" },
                "description": { "type": "string" }
              }
            }
          }
        }
      },
      "FoodNutritionData": {
        "type": "object",
        "properties": {
          "fdcId": { "type": "integer", "format": "int64" },
          "description": { "type": "string" },
          "foodNutrients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "amount": { "type": "number", "format": "double" },
                "unitName": { "type": "string" },
                "nutrient": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "unitName": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "CorrelationAnalysis": {
        "type": "object",
        "properties": {
          "city": { "type": "string" },
          "crop": { "type": "string" },
          "weatherScore": { "type": "number", "format": "double" },
          "nutritionScore": { "type": "number", "format": "double" },
          "overallQuality": { "type": "number", "format": "double" },
          "analysis": { "type": "string" },
          "timestamp": { "type": "integer", "format": "int64" }
        }
      },
      "HarvestBatch": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "cropProfileId": { "type": "integer", "format": "int64" },
          "harvestDate": { "type": "string", "example": "2024-03-15" },
          "quantityKg": {
            "type": "number",
            "format": "double",
            "example": 150.5
          },
          "qualityGrade": { "type": "string", "example": "A" },
          "actualNutrients": { "type": "object" },
          "storageConditions": {
            "type": "string",
            "example": "Cold storage at 4°C"
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "MealSource": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "trackerId": { "type": "integer", "format": "int64" },
          "mealName": { "type": "string", "example": "Organic Tomato Salad" },
          "mealDate": { "type": "string", "example": "2024-03-15" },
          "ingredients": { "type": "array", "items": { "type": "string" } },
          "localSourcePercentage": {
            "type": "number",
            "format": "double",
            "example": 0.85
          },
          "nutritionalDensity": {
            "type": "number",
            "format": "double",
            "example": 7.8
          },
          "farmOrigin": {
            "type": "string",
            "example": "Local Organic Farm, Jyväskylä"
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Link" }
          }
        }
      },
      "Link": {
        "type": "object",
        "properties": {
          "link": { "type": "string" },
          "rel": { "type": "string" }
        }
      }
    }
  }
}
