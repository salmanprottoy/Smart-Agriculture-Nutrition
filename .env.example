# Smart Agriculture Nutrition - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# EXTERNAL API CONFIGURATION
# =============================================================================

# WeatherAPI.com Configuration
# Get your free API key from: https://www.weatherapi.com/signup.aspx
# Free tier: 1,000,000 calls/month, real-time weather data
WEATHERAPI_KEY=your_weatherapi_key_here

# USDA FoodData Central API Configuration
# Get your API key from: https://fdc.nal.usda.gov/api-guide.html
# API key increases rate limits and provides better access
USDA_API_KEY=your_usda_api_key_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Railway PostgreSQL Configuration (automatically provided by Railway)
# Railway provides these environment variables automatically when you add a PostgreSQL service:
# DATABASE_URL=postgresql://user:password@host:port/database
# PGHOST=<auto-provisioned>
# PGPORT=5432
# PGDATABASE=railway
# PGUSER=postgres
# PGPASSWORD=<auto-generated>

# Standard PostgreSQL Database Configuration (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_agriculture_nutrition
DB_USERNAME=agriculture_user
DB_PASSWORD=your_secure_password_here
# Alternative: Use DB_USER instead of DB_USERNAME for Railway compatibility
DB_USER=agriculture_user

# Database Connection Pool Settings
DB_MAX_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_CONNECTION_TIMEOUT=30000

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Railway-specific Configuration
PORT=8080
RAILWAY_ENVIRONMENT=production

# Application Environment (development, staging, production)
APP_ENVIRONMENT=development

# API Cache Configuration (in minutes)
WEATHER_CACHE_TTL=5
NUTRITION_CACHE_TTL=30

# API Rate Limiting
WEATHER_API_RATE_LIMIT=60
NUTRITION_API_RATE_LIMIT=100

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Enable/Disable API request logging
LOG_API_REQUESTS=true

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# API Security
API_KEY_REQUIRED=false
API_KEY_HEADER=X-API-Key

# =============================================================================
# AUTHENTICATION CONFIGURATION
# =============================================================================

# JWT Secret Key for token generation
JWT_SECRET=jwt-key

# =============================================================================
# SWAGGER/OPENAPI CONFIGURATION
# =============================================================================

# Swagger UI Configuration
SWAGGER_ENABLED=true
SWAGGER_TITLE=Smart Agriculture Nutrition
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Professional REST API integrating weather and nutrition data for agricultural analysis

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60

# Metrics Collection
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics

# =============================================================================
# EXTERNAL SERVICE TIMEOUTS
# =============================================================================

# HTTP Client Timeouts (in milliseconds)
HTTP_CONNECTION_TIMEOUT=10000
HTTP_READ_TIMEOUT=15000
HTTP_WRITE_TIMEOUT=10000

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY=1000

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable/Disable specific features
WEATHER_INTEGRATION_ENABLED=true
NUTRITION_INTEGRATION_ENABLED=true
CORRELATION_ANALYSIS_ENABLED=true
DATABASE_INTEGRATION_ENABLED=true
CACHE_ENABLED=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development Mode Settings
DEBUG_MODE=false
MOCK_EXTERNAL_APIS=false
ENABLE_TEST_DATA=true

# Performance Testing
LOAD_TEST_MODE=false
SIMULATE_SLOW_RESPONSES=false

# =============================================================================
# RAILWAY DEPLOYMENT CONFIGURATION
# =============================================================================

# Railway automatically provides these variables:
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=<your-project-id>
# RAILWAY_SERVICE_ID=<your-service-id>
# RAILWAY_DEPLOYMENT_ID=<deployment-id>
# RAILWAY_REPLICA_ID=<replica-id>

# Railway PostgreSQL Connection (auto-provisioned)
# DATABASE_URL=postgresql://user:password@host.railway.internal:5432/railway
# PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD are also provided

# Railway Public URL (after deployment)
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# Additional Railway Settings
# RAILWAY_HEALTHCHECK_TIMEOUT=300
# RAILWAY_NUM_REPLICAS=1
