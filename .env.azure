# Azure Environment Configuration for Smart Agriculture Nutrition API
# Copy this file to .env and update with your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=smart_agriculture_nutrition
POSTGRES_USER=agriculture_user
POSTGRES_PASSWORD=ChangeThisToASecurePassword2024!

# Database connection (for application)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_agriculture_nutrition
DB_USERNAME=agriculture_user
DB_PASSWORD=ChangeThisToASecurePassword2024!

# ============================================
# EXTERNAL API KEYS
# ============================================
# OpenWeatherMap API Key
# Get your free API key from: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# USDA FoodData Central API Key
# Get your free API key from: https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=your_usda_fooddata_api_key_here

# ============================================
# SECURITY CONFIGURATION
# ============================================
# JWT Secret Key (change this to a secure random string)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your-super-secure-jwt-secret-key-change-this-2024

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Application port
PORT=8080

# Environment (development, staging, production)
APP_ENVIRONMENT=production

# JVM Options for container
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0

# ============================================
# AZURE SPECIFIC CONFIGURATION (Optional)
# ============================================
# Azure Application Insights (for monitoring)
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=your-key-here

# Azure Key Vault (if using for secrets)
# AZURE_KEY_VAULT_URI=https://your-keyvault.vault.azure.net/

# ============================================
# CORS CONFIGURATION (Optional)
# ============================================
# Allowed origins for CORS (comma-separated)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# LOGGING CONFIGURATION (Optional)
# ============================================
# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=/var/log/smart-agriculture/app.log

# ============================================
# PERFORMANCE TUNING (Optional)
# ============================================
# Database connection pool settings
DB_MAX_CONNECTIONS=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT=30000

# Tomcat settings
TOMCAT_MAX_THREADS=200
TOMCAT_MIN_SPARE_THREADS=10
TOMCAT_CONNECTION_TIMEOUT=20000

# ============================================
# BACKUP CONFIGURATION (Optional)
# ============================================
# Backup schedule (cron format)
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup retention days
# BACKUP_RETENTION_DAYS=7

# ============================================
# NOTES
# ============================================
# 1. Never commit this file with actual credentials to git
# 2. Use strong, unique passwords for production
# 3. Rotate API keys and secrets regularly
# 4. Consider using Azure Key Vault for production secrets
# 5. Enable Azure Application Insights for monitoring
# 6. Set up proper backup strategies for production data
